{
  "manifest_version": 3,
  "name": "Stats for bees",
  "version": "1.1.2",
  "description": "Displays Rate My Professor ratings and Course Critique data directly on Georgia Tech's registration page.",
  "host_permissions": [
    "https://www.ratemyprofessors.com/*",
    "https://c4citk6s9k.execute-api.us-east-1.amazonaws.com/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://registration.banner.gatech.edu/StudentRegistrationSsb/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}